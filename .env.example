# Copy to .env on the server and replace every value.

MSSQL_SA_PASSWORD=Change_Me_Str0ng_32_chars
JWT_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_ISSUER=NeuroStrokeCare.api
JWT_AUDIENCE=NeuroStrokeCare.Client
JWT_DURATION_MINUTES=60

# Used by docker-compose.prod.yml
DB_NAME=NeuroStrokeCareDB
API_PORT=8080
WEB_PORT=3000
ASPNETCORE_ENVIRONMENT=Production

# Optional development-only seed password. Do not use in production.
SEED_USERS_DEFAULT_PASSWORD=Change_Me_Dev_Only
