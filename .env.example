# Copy to .env on the server and replace every value.

MSSQL_SA_PASSWORD=Change_Me_Str0ng_32_chars
JWT_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_ISSUER=NeuroStrokeCare.api
JWT_AUDIENCE=NeuroStrokeCare.Client
JWT_DURATION_MINUTES=60

# Used by docker-compose.prod.yml
DB_NAME=NeuroStrokeCareDB
API_PORT=8080
WEB_PORT=3000
ASPNETCORE_ENVIRONMENT=Production

# Optional development-only seed password. Do not use in production.
SEED_USERS_DEFAULT_PASSWORD=Change_Me_Dev_Only

# SMTP settings used to send real password-reset emails. Leave SMTP_HOST
# blank to disable email sending (the API just logs a warning instead of
# failing) — useful while you don't have SMTP credentials yet.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_ENABLE_SSL=true
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=NeuroStrokeCare
# Public URL of the deployed frontend's reset-password page — this is the
# link that gets emailed to the user, so it must be reachable from outside
# the server, not "localhost".
FRONTEND_RESET_URL=https://your-domain.example/reset-password
